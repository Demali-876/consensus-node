[Unit]
Description=Consensus Node (runtime server + control tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/consensus-node.env
Environment=CONSENSUS_SERVER_URL=https://consensus.canister.software
Environment=CONSENSUS_STATE_DIR=/var/lib/consensus-node/state
Environment=CONSENSUS_NODE_INSTALL_DIR=/opt/consensus-node
Environment=CONSENSUS_NODE_UPDATE_COMMAND=/opt/consensus-node/current/scripts/install-release.sh
# supervise.ts runs under its `#!/usr/bin/env bun` shebang, so bun must be on the
# unit's PATH. systemd's default PATH omits it; %h expands to the home of whichever
# user the unit runs as, which is where ensure-bun.sh installs bun ($HOME/.bun/bin).
Environment=PATH=%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/consensus-node/current/src/supervise.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
